# gta6 — harness facts. Tools WRITE this; agents READ it.
# The env is truth: never keep a private copy of a fact that lives here.
# Paths to secrets only. Never a secret.

REPO_NAME=gta6
BA_ADAPTER=web
APP_BUNDLE_ID=com.efoltyn.ganglife

BA_PRESET=car-interiors
# HARNESS_AGENT=    claude | codex — default agent for `go` here

# ba, flagless waves: shoot the BEFORE off a HEAD worktree served on its own port
#   git worktree add --detach /tmp/head HEAD && (cd /tmp/head && PORT=8611 python3 tools/devserver.py &)
#   ba --preset <p> --before http://127.0.0.1:8611/     # after = this checkout
