{
  "name": "cell-block-z",
  "private": true,
  "version": "0.1.0",
  "description": "Vite dev/build harness for the legacy IIFE game (O1 — MASTER-PLAN Part II OSS/Vite bridge). Legacy game files are untouched and keep working with a dumb static server; `npm run dev`/`npm run build` add a parallel module world via src/bootstrap.js.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:pages": "npm run build && node tools/test-pages-build-browser.mjs",
    "test:interiors": "node tools/test-interior-containment-browser.mjs",
    "test:wildlife-attachments": "node tools/test-wildlife-attachments.mjs",
    "test:attachments": "node tools/test-reality-support.mjs && node tools/test-wildlife-attachments.mjs && node tools/test-authored-attachments.mjs",
    "test:wildlife-mount": "node tools/test-wildlife-mount-browser.mjs",
    "test:aquatic-mount": "node tools/test-aquatic-mount-browser.mjs",
    "test:shark-mouth": "node tools/test-shark-mouth-browser.mjs",
    "test:battle": "node tools/battle-check.mjs",
    "test:battle-revert": "node tools/battle-check.mjs --revert",
    "test:bailout-presentation": "node tools/test-bailout-presentation-browser.mjs",
    "visual:compare": "node tools/visual-compare.mjs",
    "visual:wildlife": "node tools/visual-compare.mjs --preset wildlife-attachments --before https://efoltyn.github.io/gta6/",
    "visual:mounted-riders": "node tools/visual-compare.mjs --preset mounted-riders --before https://efoltyn.github.io/gta6/",
    "visual:sea-mounts": "node tools/visual-compare.mjs --preset sea-mounts --before https://efoltyn.github.io/gta6/",
    "visual:shark-bites": "node tools/visual-compare.mjs --preset shark-bites --before https://efoltyn.github.io/gta6/",
    "visual:parachute": "node tools/visual-compare.mjs --preset parachute-rig --before https://efoltyn.github.io/gta6/",
    "visual:nuke": "node tools/visual-compare.mjs --preset nuke-sequence --before https://efoltyn.github.io/gta6/",
    "visual:b2-spawn": "node tools/visual-compare.mjs --preset b2-spawn --before https://efoltyn.github.io/gta6/",
    "visual:jail": "node tools/visual-compare.mjs --preset jail-scene --keep-going --before https://efoltyn.github.io/gta6/",
    "visual:prison-combat": "node tools/visual-compare.mjs --preset prison-combat-looks --keep-going --before https://efoltyn.github.io/gta6/",
    "visual:prison-blood": "node tools/visual-compare.mjs --preset prison-blood --keep-going --before https://efoltyn.github.io/gta6/",
    "visual:prison-shank": "node tools/visual-compare.mjs --preset prison-shank --keep-going --before https://efoltyn.github.io/gta6/",
    "visual:prison-beds": "node tools/visual-compare.mjs --preset prison-beds --keep-going --before https://efoltyn.github.io/gta6/",
    "visual:prison-outfits": "node tools/visual-compare.mjs --preset prison-outfit-gallery --keep-going --before https://efoltyn.github.io/gta6/",
    "visual:disasters": "node tools/visual-compare.mjs --preset disaster-sequence --keep-going --before https://efoltyn.github.io/gta6/",
    "visual:race-stadium": "node tools/visual-compare.mjs --preset race-stadium --before https://efoltyn.github.io/gta6/",
    "visual:president": "node tools/visual-compare.mjs --preset president-compound --before https://efoltyn.github.io/gta6/",
    "visual:interiors": "node tools/visual-compare.mjs --preset interiors --before https://efoltyn.github.io/gta6/",
    "visual:npc-gestures": "node tools/visual-compare.mjs --preset npc-gestures --keep-going --before https://efoltyn.github.io/gta6/",
    "visual:role-outfits": "node tools/visual-compare.mjs --preset role-outfit-gallery --keep-going --before https://efoltyn.github.io/gta6/",
    "visual:captain-fleet": "node tools/visual-compare.mjs --preset captain-fleet --keep-going --before https://efoltyn.github.io/gta6/",
    "visual:prison-rooms": "node tools/visual-compare.mjs --preset prison-rooms --keep-going --before https://efoltyn.github.io/gta6/",
    "visual:prison-doors": "node tools/visual-compare.mjs --preset prison-doors --keep-going --before https://efoltyn.github.io/gta6/",
    "visual:prison-wing-props": "node tools/visual-compare.mjs --preset prison-wing-props --keep-going --before https://efoltyn.github.io/gta6/",
    "visual:prison-yard-props": "node tools/visual-compare.mjs --preset prison-yard-props --keep-going --before https://efoltyn.github.io/gta6/"
  },
  "devDependencies": {
    "three": "^0.164.1",
    "vite": "^5.4.0"
  }
}
