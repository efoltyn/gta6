node_modules/
# the worktree setup symlinks node_modules from the main checkout; the
# trailing-slash rule above does not match a symlink, so cover it bare
node_modules
*.log
.DS_Store
server/worlds/
tools/shots/
rust/**/target/

# O1 (BUILD-PLAN.md Stage O): `vite build` output — a copied-through static
# bundle (legacy tree + dist/assets/bootstrap.js), regenerable via
# `npm run build`. Never the source of truth; not committed.
dist/

# Subagent scratch worktrees. Each is a full second checkout of this repo that
# the agent harness creates, locks and removes on its own; committing one would
# commit the repository into itself.
.claude/worktrees/

# generated world-audit artifacts
tools/audit/
aircraft-current-orbit.png

# Generated before/after screenshots, HTML contact sheets, and PDFs.
artifacts/visual-comparisons/

# Local third-party/reference inputs. These are inspected as design sources,
# never loaded by the game and should not be published by GitHub Pages.
FluffyGrass-main.zip
JUNGLEEXAMPLECODE.zip
KIMIWATEREXAMPLE.zip
The-Mountains-of-Madness-main.zip
treesMODELCODE.js

# Local secrets. custom.env is TRACKED, so nothing with a key in it goes there.
# A committed key gets scanned and auto-revoked within minutes, which breaks the
# thing it was added for — so this file is ignored and never committed.
.env.local
disaster.candidate-*.html

# The iOS web bundle is a BUILD ARTIFACT — 19 MB of copied assets and a
# concatenation of files that are already in this repo. `npm run build:ios`
# regenerates it in a second, and Capacitor copies it into the app at sync
# time; nothing needs the committed copy.
dist-ios/

# Natural Disaster Survival's Xcode project — GENERATED on the Mac
# (cd apps/disaster-ios && npx cap add ios), then patched by tools/setup-ios.mjs.
# Gang Life's project at ios/App is the opposite: committed, hand-tuned, tracked.
apps/disaster-ios/ios/
